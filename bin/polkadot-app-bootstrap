#!/usr/bin/env node

import { DEFAULT_POOL_SIZE, NonRetryableError, EXIT_CODE_NO_RETRY } from "../dist/deploy.js";
import { loadStack, resolveStackSelection } from "../dist/stacks.js";
import { bootstrapPool, resolvePoolMnemonic, describeIgnoredPoolMnemonicEnv } from "../dist/pool.js";
import { VERSION } from "../dist/telemetry.js";

const args = process.argv.slice(2);

const flags = {};
for (let i = 0; i < args.length; i++) {
  if (args[i] === "--pool-size") { flags.poolSize = parseInt(args[++i], 10); }
  else if (args[i] === "--mnemonic") { flags.mnemonic = args[++i]; }
  else if (args[i] === "--authorizer") { flags.authorizer = args[++i]; }
  else if (args[i] === "--rpc") { flags.rpc = args[++i]; }
  else if (args[i] === "--env") { flags.env = args[++i]; }
  else if (args[i] === "--stack") { flags.stack = args[++i]; }
  else if (args[i] === "--version" || args[i] === "-V") { flags.version = true; }
  else if (args[i] === "--help" || args[i] === "-h") { flags.help = true; }
  else {
    console.error(`Error: unknown argument ${args[i]}`);
    process.exit(1);
  }
}

if (flags.version) {
  console.log(`polkadot-app-bootstrap v${VERSION}`);
  process.exit(0);
}

if (flags.help) {
  console.log(`polkadot-app-bootstrap v${VERSION}

Usage:
  polkadot-app-bootstrap [options]

Reports the authorization status of each pool account and, when an authorizer
key is available, grants authorization to any account that needs it.

The Bulletin chain has no fee model — storage access is gated by TransactionStorage
authorization quota, not account balance. This tool manages that quota.

Aliases: pad-bootstrap (short), polkadot-app-bootstrap (full)

Options:
  --mnemonic "..."    Pool root mnemonic used to derive pool accounts
                      (also readable from BULLETIN_POOL_MNEMONIC or MNEMONIC env var).
                      Default: the well-known dev phrase (same key the deploy path uses).
  --authorizer "..."  Seed/mnemonic of the key that holds authorization authority
                      on this chain (e.g. "//Alice", a full mnemonic, or a hex seed).
                      When --env or --stack is given and omitted, falls back to that
                      stack's configured authorizer (the bulletinAuthorizer field of
                      its policy, e.g. //Alice on paseo-next-v2).
                      There is no other default: some stacks (e.g. pcf-devnet) are
                      community-operated and their authorizer is unknown, so omitting
                      both fails with a clear message instead of guessing — omit to
                      get status only.
  --rpc wss://...     Bulletin RPC endpoint (or set BULLETIN_RPC env var). With
                      --env/--stack its genesis hash must match the stack's
                      Bulletin chain; alone, no stack policy applies.
  --env <id>          Built-in stack id or alias (default: paseo-next-v2 when
                      neither --rpc nor --stack is set)
  --stack <link|URL|file>
                      Any other stack descriptor (cannot be combined with --env)
  --pool-size N       Number of pool accounts to check/initialize (default: 10)
  --version           Show version
  --help              Show this help`);
  process.exit(0);
}

try {
  const selection = resolveStackSelection({ flagEnv: flags.env, flagStack: flags.stack });
  const hasSelection = selection.env !== undefined || selection.stack !== undefined;
  const rpcOverride = flags.rpc ?? process.env.BULLETIN_RPC;
  const poolSize = flags.poolSize ?? parseInt(process.env.BULLETIN_POOL_SIZE ?? String(DEFAULT_POOL_SIZE), 10);
  // Same resolver the deploy path uses (src/pool.ts), so the accounts this tool authorizes are
  // exactly the accounts a deploy will upload from. It deliberately ignores MNEMONIC — that selects
  // the DotNS signing account, and honouring it here authorized a set of //deploy/N accounts no
  // deploy ever touches, with no visible symptom until storage failed on a bootstrapped env.
  const mnemonic = resolvePoolMnemonic(flags.mnemonic);
  const ignoredMnemonicWarning = describeIgnoredPoolMnemonicEnv(process.env, flags.mnemonic);
  if (ignoredMnemonicWarning) console.warn(`⚠  ${ignoredMnemonicWarning}`);

  const bootstrapOpts = {};
  if (flags.authorizer) {
    bootstrapOpts.authorizerMnemonic = flags.authorizer;
  }

  // A bare --rpc / BULLETIN_RPC targets that chain without a stack: no genesis check and no stack policy.
  let stack;
  let rpc = rpcOverride;
  if (hasSelection || !rpcOverride) {
    stack = await loadStack(selection);
    rpc = rpcOverride ?? stack.chains.Bulletin.rpc[0];
    bootstrapOpts.stack = stack;
  }

  await bootstrapPool(rpc, poolSize, mnemonic, bootstrapOpts);

} catch (e) {
  console.error(`Error: ${e.message}`);
  process.exit(e instanceof NonRetryableError ? EXIT_CODE_NO_RETRY : 1);
}
